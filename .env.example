# =============================================================================
# ShareBox - Environment Configuration Template
# =============================================================================
# Copy this file to .env and populate with your actual credentials.
# DO NOT commit real secrets or credentials to version control.

# -----------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL via Prisma ORM)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sharebox_db?schema=public"

# -----------------------------------------------------------------------------
# 2. Authentication Secret (32+ character random string for signing JWT tokens)
# -----------------------------------------------------------------------------
AUTH_SECRET="sharebox-production-secret-key-replace-with-32chars"

# -----------------------------------------------------------------------------
# 3. Public Application URL (Used for generating folder short URLs and links)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# 4. S3-Compatible / Cloudflare R2 Object Storage Configuration
# -----------------------------------------------------------------------------
# Option A: Cloudflare R2
# - STORAGE_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# - STORAGE_ACCESS_KEY="<R2_ACCESS_KEY_ID>"
# - STORAGE_SECRET_KEY="<R2_SECRET_ACCESS_KEY>"
# - STORAGE_BUCKET="sharebox-bucket"
#
# Option B: AWS S3
# - STORAGE_ENDPOINT="https://s3.us-east-1.amazonaws.com"
# - STORAGE_ACCESS_KEY="<AWS_ACCESS_KEY_ID>"
# - STORAGE_SECRET_KEY="<AWS_SECRET_ACCESS_KEY>"
# - STORAGE_BUCKET="your-bucket-name"
# - STORAGE_REGION="us-east-1"
#
# Option C: MinIO (Self-hosted)
# - STORAGE_ENDPOINT="http://localhost:9000"
# - STORAGE_ACCESS_KEY="minioadmin"
# - STORAGE_SECRET_KEY="minioadmin"
# - STORAGE_BUCKET="sharebox"
#
# Note: If credentials contain "placeholder" or are left unconfigured in local dev,
# ShareBox automatically uses its secure server-side disk storage fallback
# (.storage_uploads/) with signed HMAC download tokens so uploads work out of the box!
STORAGE_ENDPOINT="https://s3.us-east-1.amazonaws.com"
STORAGE_ACCESS_KEY="local-access-key-placeholder"
STORAGE_SECRET_KEY="local-secret-key-placeholder"
STORAGE_BUCKET="sharebox-local-bucket"
STORAGE_REGION="auto"

# -----------------------------------------------------------------------------
# 5. Expiration & Cleanup (Part 7)
# -----------------------------------------------------------------------------
# Retention is configured in SystemSetting (admin > settings):
#   guest_folder_lifespan_hours (default 24), user_folder_lifespan_days (default 15)
#
# Scheduler secret for GET/POST /api/cron/cleanup (send "Authorization: Bearer <secret>").
# Run it every 5-15 minutes. Optional "Idempotency-Key: <tick id>" dedupes retried deliveries.
CRON_SECRET="replace-with-a-long-random-string"

# Expiry warning delivery for registered users: "log" (default) writes to server logs.
NOTIFICATION_PROVIDER="log"

# DEV/TEST ONLY - ignored when NODE_ENV=production unless ALLOW_TEST_CLOCK=true.
# Shift the server expiration clock forward (seconds). Prefer POST /api/dev/clock at runtime.
# DEV_CLOCK_OFFSET_SECONDS=0
# Give every new folder this lifespan (seconds) instead of the retention policy.
# TEST_EXPIRATION_SECONDS=120
# ALLOW_TEST_CLOCK=false
